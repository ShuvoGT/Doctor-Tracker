# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:3000

# ---- Database ----
# Provide a MongoDB connection string. Local example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker
# Atlas example:
#   MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/doctor_tracker
#
# If MONGODB_URI is left EMPTY, the server automatically boots an in-memory
# MongoDB (mongodb-memory-server) so you can run the project without installing
# MongoDB. Data in that mode is reset every restart.
MONGODB_URI=

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Seed admin credentials ----
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@doctortracker.com
SEED_ADMIN_PASSWORD=Admin@123
